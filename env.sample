
# Flask ENV
FLASK_APP=run.py
FLASK_DEBUG=False

# Used for CDN (in production)
# No Slash at the end
ASSETS_ROOT=/static/assets

# Optional read-only connection to a pgAssistant Collector repository.
# When set, the Executive Plan page exposes its History tab.
COLLECTOR_URI=postgresql://collector_reader:password@collector-host:5432/pga_collector

# Optional bearer token protecting /api/v2 endpoints.
# Leave unset or empty to disable API authentication.
PGA_API_TOKEN=
